{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  // Renovate owns what Dependabot cannot see here: the digest-pinned base images in
  // .github/base-images.yaml, which drive `ARG BUILD_FROM` in the Dockerfile. Dependabot's
  // docker manager only understands a literal `FROM` line, so it cannot follow a custom YAML
  // field.
  //
  // It also takes GitHub Actions and the Dockerfile's own `FROM` lines, so that neither bot
  // raises a duplicate PR for them. Python stays with Dependabot: requirements-lock.txt is a
  // hash-locked `uv pip compile` output installed with --require-hashes, and Renovate cannot
  // regenerate those hashes - it would edit the lock and leave it inconsistent.
  //
  // enabledManagers is deliberately an allow-list. config:recommended enables every manager,
  // which would have Renovate and Dependabot both raising pip PRs.
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommitTypeAll(build)",
  ],
  "enabledManagers": ["github-actions", "dockerfile", "custom.regex"],
  "timezone": "Europe/London",
  // Personal repo, worked on at weekends: have the PRs waiting on Saturday morning rather
  // than arriving on a Monday.
  "schedule": ["before 6am on saturday"],
  "semanticCommits": "enabled",
  "semanticCommitScope": "deps",
  "labels": ["dependencies"],
  "prConcurrentLimit": 3,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Keep the HA addon base-image digests in .github/base-images.yaml fresh",
      "managerFilePatterns": ["/^\\.github/base-images\\.yaml$/"],
      "matchStrings": [
        "(?<depName>ghcr\\.io/home-assistant/[a-z0-9]+-base):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)",
      ],
      "datasourceTemplate": "docker",
    },
    {
      "customType": "regex",
      // TEMPIO_REF pins the tempio build stage by immutable commit SHA. No manifest declares
      // it, so Dependabot cannot see it at all - it sat on an untagged mid-main commit from
      // 2026-06-30 with no way to notice 2026.07.0 had shipped.
      //
      // Tags, not the branch head: a bump should mean an upstream release, not merely the
      // newest commit on main. Versioning is `loose` because tempio uses calendar versions
      // like 2026.07.0, which semver rejects for the leading zero in the month.
      "description": "Track the tempio build-stage pin against upstream releases",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": [
        "# tempio (?<currentValue>[\\d.]+)\nARG TEMPIO_REF=(?<currentDigest>[a-f0-9]{40})",
      ],
      "autoReplaceStringTemplate": "# tempio {{{newValue}}}\nARG TEMPIO_REF={{{newDigest}}}",
      "depNameTemplate": "home-assistant/tempio",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "loose",
    },
  ],
  "packageRules": [
    {
      "description": "One PR for all base-image digest bumps - they must move together, since build.yml and release.yml build every arch from the same matrix.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/home-assistant/**"],
      "groupName": "home-assistant-base-images",
    },
    {
      "description": "One PR for all GitHub Actions, matching the grouping Dependabot used before this change.",
      "matchManagers": ["github-actions"],
      "groupName": "actions",
    },
  ],
}
